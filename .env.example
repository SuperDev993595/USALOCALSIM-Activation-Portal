# Database (Hostinger MySQL from hPanel)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-secret"

# Stripe
STRIPE_SECRET_KEY="sk_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_..."

# Email (Option A: Resend - set RESEND_API_KEY; Option B: SMTP - set SMTP_*)
# Cart Stripe webhook sends a payment receipt + resume link when RESEND or SMTP is configured.
# RESEND_API_KEY="re_..."
# SMTP_HOST="smtp.hostinger.com"
# SMTP_PORT=465
# SMTP_USER="..."
# SMTP_PASS="..."
EMAIL_FROM="noreply@yourdomain.com"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SIM_HARDWARE_COST_CENTS=999

# /cart — optional ISO country code for national phone input without + (e.g. GB, DE). International +… always works.
# SHOP_PHONE_DEFAULT_REGION="US"

# /cart voucher flow — Prelude SMS verification (https://docs.prelude.so/verify/v2/documentation/quickstart)
# PRELUDE_API_TOKEN="..."   # or API_TOKEN — v2 API key from Prelude dashboard
# Optional: PRELUDE_DEBUG=1 — return more detailed Prelude errors in API responses (dev/troubleshooting)
# Optional: SHOP_PRELUDE_SKIP=1 — do not call Prelude; use code 123456 at verify step (local dev only)
# SHOP_PRELUDE_SKIP=1

# Path B — POS activation (retailer scan + pay)
# POS_API_KEY="long-random-secret"

# /cart + Phase 2 upgrade (Brazil) — Mercado Pago Checkout Pro
# MERCADOPAGO_ACCESS_TOKEN="..."
# NEXT_PUBLIC_CART_MERCADOPAGO_ENABLED="true"
